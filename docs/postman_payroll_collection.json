{
	"info": {
		"_postman_id": "payroll-collection",
		"name": "JVAIR V2 - Payroll",
		"description": "Colección de endpoints para gestión de payroll (nómina) de técnicos. Permite listar, marcar pagos, ver y enviar recibos de pago (paystub).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "userId",
			"value": "1",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Listar payroll de usuarios",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/payroll?page=1&pageSize=20",
					"host": ["{{baseUrl}}"],
					"path": ["payroll"],
					"query": [
						{ "key": "page", "value": "1", "description": "Número de página (default: 1)" },
						{ "key": "pageSize", "value": "20", "description": "Tamaño de página (default: 20)" },
						{ "key": "search", "value": "", "description": "Búsqueda por nombre o email", "disabled": true },
						{ "key": "userId", "value": "", "description": "Filtrar por ID de usuario específico", "disabled": true }
					]
				},
				"description": "Obtiene la lista de usuarios con sus rates de payroll agrupados por estado (unpaid, holding, paid). Incluye totales calculados por usuario."
			},
			"response": []
		},
		{
			"name": "Obtener payroll de un usuario",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/payroll/{{userId}}?page=1&pageSize=50",
					"host": ["{{baseUrl}}"],
					"path": ["payroll", "{{userId}}"],
					"query": [
						{ "key": "page", "value": "1", "description": "Número de página (default: 1)" },
						{ "key": "pageSize", "value": "50", "description": "Tamaño de página (default: 50)" },
						{ "key": "status", "value": "unpaid", "description": "Filtrar por estado: unpaid, holding, paid, all", "disabled": true }
					]
				},
				"description": "Obtiene los rates de payroll de un usuario específico con información enriquecida del job (work order, dirección, etc.)."
			},
			"response": []
		},
		{
			"name": "Obtener payroll - Solo unpaid",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/payroll/{{userId}}?status=unpaid",
					"host": ["{{baseUrl}}"],
					"path": ["payroll", "{{userId}}"],
					"query": [
						{ "key": "status", "value": "unpaid" }
					]
				},
				"description": "Obtiene solo los rates pendientes de pago de un usuario."
			},
			"response": []
		},
		{
			"name": "Obtener payroll - Solo holding",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/payroll/{{userId}}?status=holding",
					"host": ["{{baseUrl}}"],
					"path": ["payroll", "{{userId}}"],
					"query": [
						{ "key": "status", "value": "holding" }
					]
				},
				"description": "Obtiene solo los rates retenidos de un usuario."
			},
			"response": []
		},
		{
			"name": "Obtener payroll - Solo paid",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/payroll/{{userId}}?status=paid",
					"host": ["{{baseUrl}}"],
					"path": ["payroll", "{{userId}}"],
					"query": [
						{ "key": "status", "value": "paid" }
					]
				},
				"description": "Obtiene solo los rates ya pagados de un usuario."
			},
			"response": []
		},
		{
			"name": "Marcar rates como pagados",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"rateIds\": [1, 2, 3]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/payroll/{{userId}}/mark-paid",
					"host": ["{{baseUrl}}"],
					"path": ["payroll", "{{userId}}", "mark-paid"]
				},
				"description": "Marca los rates especificados como pagados. Los IDs deben corresponder a rates del usuario indicado."
			},
			"response": []
		},
		{
			"name": "Marcar rates como retenidos",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"rateIds\": [4, 5]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/payroll/{{userId}}/mark-held",
					"host": ["{{baseUrl}}"],
					"path": ["payroll", "{{userId}}", "mark-held"]
				},
				"description": "Marca los rates especificados como retenidos (holding). Útil cuando hay algún problema con el trabajo y se necesita revisar antes de pagar."
			},
			"response": []
		},
		{
			"name": "Ver paystub (recibo de pago)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/payroll/{{userId}}/paystub",
					"host": ["{{baseUrl}}"],
					"path": ["payroll", "{{userId}}", "paystub"]
				},
				"description": "Obtiene el recibo de pago (paystub) de un usuario con todos sus rates pendientes, totales calculados y fecha de generación."
			},
			"response": []
		},
		{
			"name": "Enviar paystub por email",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"emails\": \"tecnico@example.com, admin@example.com\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/payroll/{{userId}}/paystub/email",
					"host": ["{{baseUrl}}"],
					"path": ["payroll", "{{userId}}", "paystub", "email"]
				},
				"description": "Envía el recibo de pago (paystub) del usuario a las direcciones de email especificadas. Se pueden enviar múltiples emails separados por coma."
			},
			"response": []
		}
	]
}
