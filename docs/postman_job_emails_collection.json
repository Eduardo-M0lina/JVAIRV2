{
  "info": {
    "_postman_id": "job-emails-collection-001",
    "name": "JVAIR Job Emails",
    "description": "Collection for testing Job Emails log endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Job Emails",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}/emails?page=1&limit=15",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "jobs",
            "{{jobId}}",
            "emails"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "15"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Job Email Log",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipients\": [\"dispatch@wecoolatlanta.com\", \"tech@example.com\"],\n  \"type\": \"dispatch\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}/emails",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "jobs",
            "{{jobId}}",
            "emails"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Job Email Log",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}/emails/{{emailId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "jobs",
            "{{jobId}}",
            "emails",
            "{{emailId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "jobId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "emailId",
      "value": "1",
      "type": "string"
    }
  ]
}
