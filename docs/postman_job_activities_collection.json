{
	"info": {
		"_postman_id": "job-activities-collection",
		"name": "JVAIR V2 - Job Activity Logs",
		"description": "Colección de endpoints para registros de actividades de trabajos (bitácora de eventos y comunicaciones).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "jobId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "activityId",
			"value": "1",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Crear actividad/nota",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"userId\": 1,\n  \"type\": \"phone_call\",\n  \"log\": \"Cliente confirmó disponibilidad para visita técnica el martes 10am. Contacto: María González.\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/jobs/{{jobId}}/activities",
					"host": ["{{baseUrl}}"],
					"path": ["jobs", "{{jobId}}", "activities"]
				}
			},
			"response": []
		},
		{
			"name": "Listar actividades de un trabajo",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/jobs/{{jobId}}/activities?limit=50&page=1",
					"host": ["{{baseUrl}}"],
					"path": ["jobs", "{{jobId}}", "activities"],
					"query": [
						{ "key": "limit", "value": "50" },
						{ "key": "page", "value": "1" }
					]
				}
			},
			"response": []
		},
		{
			"name": "Eliminar actividad",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/jobs/{{jobId}}/activities/{{activityId}}",
					"host": ["{{baseUrl}}"],
					"path": ["jobs", "{{jobId}}", "activities", "{{activityId}}"]
				}
			},
			"response": []
		}
	]
}
