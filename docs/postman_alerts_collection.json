{
	"info": {
		"_postman_id": "alert-module-collection",
		"name": "JVAIRV2 - Alerts",
		"description": "Collection for Alert endpoints in JVAIRV2 API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "List Alerts",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/alerts?page=1&limit=15&isRead=false&alertType=system&entityType=job",
					"host": ["{{baseUrl}}"],
					"path": ["alerts"],
					"query": [
						{
							"key": "page",
							"value": "1",
							"description": "Page number (default: 1)"
						},
						{
							"key": "limit",
							"value": "15",
							"description": "Items per page (default: 15)"
						},
						{
							"key": "isRead",
							"value": "false",
							"description": "Filter by read status (true/false)"
						},
						{
							"key": "alertType",
							"value": "system",
							"description": "Filter by alert type"
						},
						{
							"key": "entityType",
							"value": "job",
							"description": "Filter by entity type"
						},
						{
							"key": "userId",
							"value": "146",
							"description": "Filter by user ID",
							"disabled": true
						}
					]
				},
				"description": "Get all alerts with optional filters and pagination"
			},
			"response": []
		},
		{
			"name": "Get Alert by ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/alerts/{{alertId}}",
					"host": ["{{baseUrl}}"],
					"path": ["alerts", "{{alertId}}"]
				},
				"description": "Get a single alert by its ID"
			},
			"response": []
		},
		{
			"name": "Create Alert",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": 146,\n    \"alertType\": \"system\",\n    \"entityId\": 36631,\n    \"entityType\": \"job\",\n    \"messageLevel\": \"info\",\n    \"message\": \"Job WO-36631 has been updated.\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/alerts",
					"host": ["{{baseUrl}}"],
					"path": ["alerts"]
				},
				"description": "Create a new alert (typically used by system events)"
			},
			"response": []
		},
		{
			"name": "Mark Alert as Read",
			"request": {
				"method": "PUT",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/alerts/{{alertId}}/read",
					"host": ["{{baseUrl}}"],
					"path": ["alerts", "{{alertId}}", "read"]
				},
				"description": "Mark a single alert as read"
			},
			"response": []
		},
		{
			"name": "Mark All Alerts as Read",
			"request": {
				"method": "PUT",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/alerts/read-all",
					"host": ["{{baseUrl}}"],
					"path": ["alerts", "read-all"]
				},
				"description": "Mark all unread alerts for the authenticated user as read"
			},
			"response": []
		},
		{
			"name": "Get Unread Count",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/alerts/unread-count",
					"host": ["{{baseUrl}}"],
					"path": ["alerts", "unread-count"]
				},
				"description": "Get the count of unread alerts for the authenticated user"
			},
			"response": []
		},
		{
			"name": "Delete Alert",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/alerts/{{alertId}}",
					"host": ["{{baseUrl}}"],
					"path": ["alerts", "{{alertId}}"]
				},
				"description": "Delete an alert by ID (hard delete)"
			},
			"response": []
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		}
	],
	"variable": [
		{
			"key": "alertId",
			"value": "1",
			"type": "string"
		}
	]
}
