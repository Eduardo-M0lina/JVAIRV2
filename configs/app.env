# Configuración del servidor
SERVER_PORT=3001
SERVER_TIMEOUT=30s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# Configuración de la aplicación
APP_ENV=development

# Configuración de la base de datos
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=wecooladmin
DB_PASSWORD=wecooladmin
DB_NAME=wecoolatlanta
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Configuración de JWT
JWT_ACCESS_SECRET=your_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=24h

# Configuración de AWS S3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_URL=

# Configuración de Email (Mailgun)
MAIL_FROM_ADDRESS=info@wecoolatlanta.com
MAIL_FROM_NAME=WeCool Atlanta
MAILGUN_DOMAIN=wecoolatlanta.com
MAILGUN_SECRET=
